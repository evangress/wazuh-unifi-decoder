<!-- program_name is required: the syslog pre-decoder takes "CEF" (from "CEF:0|...") as the program name,
     and Wazuh only tries decoders that declare <program_name> for such logs. -->
<decoder name="ubiquiti">
	<program_name type="pcre2">.*</program_name>
	<prematch type="pcre2">(?:^|CEF:)\d+\|Ubiquiti\|</prematch>
</decoder>

<!-- Second parent for logs with no program name at all (e.g. a bare "CEF:0|..." line):
     decoders that declare <program_name> are never tried for those. -->
<decoder name="ubiquiti">
	<prematch type="pcre2">^CEF:\d+\|Ubiquiti\|</prematch>
</decoder>

        <!-- CEF header fields -->
<!-- Standard Wazuh Fields: vendor, product -->
<decoder name="ubiquiti">
	<parent>ubiquiti</parent>
	<regex type="pcre2">(\d+)\|(Ubiquiti)\|([^|]*)\|([^|]*)\|([^|]*)\|([^|]*)\|(\d+)\|</regex>
	<order>cef.version, vendor, product, device.version, event.id, event.name, event.severity</order>
</decoder>

        <!-- UniFi namespaced keys: capture any key starting with UNIFI followed by alphanumerics -->
<decoder name="ubiquiti">
	<parent>ubiquiti</parent>
	<regex type="pcre2">\bUNIFIcategory=(\S.*?)(?=\s+[A-Za-z][A-Za-z0-9_]*=|\s*$)</regex>
	<order>unifi_category</order>
</decoder>

