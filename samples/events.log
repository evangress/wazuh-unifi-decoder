# UniFi CEF syslog samples for test.py.
#
# Each log line is preceded by an "# expect:" line:
#   decoder=NAME     decoder that must match ("!NAME" = must NOT be NAME, "none" = no decoder)
#   rule=ID level=N  rule that must fire (needs ../wazuh-unifi-rules mounted in the lab)
#   fields=a,b       decoded fields that must be present and non-empty
# "live" samples are real controller output with hostnames, client names, MACs and IPs
# anonymized. "synthetic" samples are hand-written for events not yet seen live.

# --- live: Audit ---
# expect: decoder=ubiquiti rule=100201 level=5 fields=unifi_admin,unifi_settings_section,unifi_settings_entry,unifi_settings_changes,src,cnt,unifi_utc_time
Oct 10 15:54:37 UniFi-CK CEF:0|Ubiquiti|UniFi Network|10.6.106|546|Config Modified|5|UNIFIcategory=Audit UNIFIsite=Default UNIFIhost=Cloud Key+ UNIFIsettingsChanges=contents[access_points]: access_points; log_all_contents: true; contents[gateway]: gateway; contents[firewall_default_policy]: firewall_default_policy; contents[switches]: switches UNIFIaccessMethod=web UNIFIsettingsSection=System UNIFIsettingsEntry=rsyslogd UNIFIadmin=admin src=192.168.1.59 cnt=5 UNIFIutcTime=2026-10-10T19:54:37.420Z msg=admin made 5 changes to System settings. Source IP: 192.168.1.59

